# Profile for the Dotto bot — allows only the container lifecycle endpoints
# needed by the sandbox (create, start, stop, remove, inspect, list).
# Exec endpoints are excluded — the bot communicates with sandboxes via HTTP,
# not Docker exec, and sandbox containers are never put on this network.

# Method Path
POST /(v\d+\.\d+/)?containers/create(\?.*)?
POST /(v\d+\.\d+/)?containers/[0-9a-fA-F]+/start(\?.*)?
GET /(v\d+\.\d+/)?containers/[0-9a-fA-F]+/json(\?.*)?
GET /(v\d+\.\d+/)?containers/json(\?.*)?
DELETE /(v\d+\.\d+/)?containers/[0-9a-fA-F]+(\?.*)?
POST /(v\d+\.\d+/)?containers/[0-9a-fA-F]+/stop(\?.*)?
