{
  "Bot": {
    // Partitions configuration overrides when several bot instances share one database.
    "InstanceName": "dotto",
    // User IDs allowed to manage configuration. Empty = fall back to the Discord application owner.
    "OwnerIds": []
  },
  "Discord": {
    "Token": null,
    "Prefix": ".",
    "AutoDownload": {
      "Patterns": [
        "https?:\\/\\/(?:www\\.)?instagram\\.com\\/reels?\\/[\\w\\-]+",
        "https?:\\/\\/(?:www\\.)?tiktok\\.com\\/.+\\/video\\/\\d+",
        "https?:\\/\\/(?:www\\.)?tiktok\\.com\\/t\\/[\\w\\-]+",
        "https?:\\/\\/vm\\.tiktok\\.com\\/[^\\/]+"
      ],
      "AmbiguousPatterns": [
        "https?:\\/\\/(?:www\\.)?x\\.com\\/[^\\/]+\\/status\\/.+"
      ]
    }
  },
  "UrlCorrection": {
    "Rules": [
      {
        "Patterns": ["^(https?://)?(www\\.)?kkinstagram\\.com"],
        "Replacement": "$1instagram.com"
      }
    ]
  },
  "ConnectionString": "User ID=dotto; Password=dev_only; Host=127.0.0.1; Port=5999; Database=dotto",
  "Downloader": {
    "TempPath": null,
    "CookieFile": null, // Optional Netscape-format cookies file for yt-dlp (--cookies). Docker mounts one at /app/cookies/dotto-ytdlp-cookies.txt

    "Cobalt": {
      "BaseUrl": null,
      "ApiKey": null
    }
  },
  "Ai": {
    "BaseUrl": null,
    "ApiKey": null,
    "AssistantModel": null,
    "Prompts": {
      "ChatAssistant": { "Type": "Resource", "Path": "ChatAssistant.liquid" }
    },
    "ChatAssistant": {
      // Overrides top-level Ai:AssistantModel, Ai:BaseUrl, Ai:ApiKey when set
      "Model": null,
      "BaseUrl": null,
      "ApiKey": null,
      "HistoryContextSize": 30,
      "HistoryMaxAge": "2.00:00:00", // C# timespan format: [ws][-]{ d | [d.]hh:mm[:ss[.ff]] }[ws]
                                    // https://learn.microsoft.com/en-us/dotnet/api/system.timespan.parse?view=net-10.0#examples
      "MaxAttachments": 10
    },
    "Sandbox": {
      "Enabled": true,
      "ImageTag": "dotto-sandbox:latest",
      // Base dir for per-caller persistent storage (/storage). The bot only
      // creates it; files are moved in/out through the sandbox HTTP API.
      // Default: /var/lib/dotto-sandbox (Linux), %TEMP%/dotto-sandbox-storage (Windows)
      // "StorageBasePath": null,
      "StorageQuotaMb": 200,
      // Ephemeral /work tmpfs. Counts against MemoryMb, which must be larger.
      "WorkTmpfsMb": 1024,
      "ContainerStartTimeout": "00:00:30",
      "WallClockTimeout": "00:15:00",
      "CpuCount": 1.0,
      "MemoryMb": 1536,
      "UseGVisorRuntime": false,
      // Resolvers used inside the sandbox. Egress containment drops private
      // destinations, so a LAN resolver inherited from the host would break
      // every lookup. Override if these are unreachable from your network.
      "DnsServers": [ "1.1.1.1", "8.8.8.8" ]
    }
  },
  "Minio": {
    "BaseUrl": null, // Set to non-null to enable
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "",
    "Region": "",
    "MaxFileSizeBytes": 104857600 // 100 MiB
  },
  "Compress": {
    "Thresholds": {
      "NeverCompressRatio": 0.9,
      "AlwaysCompressRatio": 0.5,
      "MinimumSavingBytes": 1048576
    },
    "Strategies": {
      "Vp9": {
        "Crf": 35,
        "AudioBitrateKbps": 64
      },
      "Av1": {
        "Crf": 38,
        "AudioBitrateKbps": 64
      }
    },
    "DefaultStrategy": "Av1"
  }
}
